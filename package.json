{
  "name": "rural-health-radio",
  "version": "0.1.0",
  "private": true,
  "description": "SIMULATED prototype: delay-tolerant rural health messaging (the 'Noor' demo). Not a medical device. Synthetic data only.",
  "license": "MIT",
  "author": "Tejas Chaudhari <tchaudha@andrew.cmu.edu>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "start": "vite build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "evidence:bytes": "tsx scripts/measure-bytes.ts",
    "evidence:contrast": "tsx scripts/contrast.ts",
    "docs:capabilities": "tsx scripts/capabilities-doc.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:server": "vite build && tsx scripts/build-hosted.ts server",
    "build:vercel": "vite build && tsx scripts/build-hosted.ts vercel",
    "start:hosted": "RHR_HOSTED=1 RHR_HOST=0.0.0.0 node dist-server/server.mjs",
    "start:vercel-sim": "tsx scripts/vercel-sim.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
